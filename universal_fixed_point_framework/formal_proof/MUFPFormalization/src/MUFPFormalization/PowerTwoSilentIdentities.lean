import Mathlib.Tactic
import MUFPFormalization.MirrorPairIdentities
import MUFPFormalization.Silence65Identities

open MUFPF.BottTower

namespace MUFPF.PowerTwoSilent

/-! =========================================================
    §1 2^m+1 家族 8 成员（186/191 截距分子全体）
   ========================================================= -/

/-- 3 = 2¹+1（家族成员 m=1——截距分子）。 -/
theorem p2_1 : 2 ^ 1 + 1 = 3 := by
  norm_num

/-- 5 = 2²+1（家族成员 m=2——截距分子 + N'=k_max−3）。 -/
theorem p2_2 : 2 ^ 2 + 1 = 5 := by
  norm_num

/-- 9 = 2³+1（家族成员 m=3——域界/对合常数）。 -/
theorem p2_3 : 2 ^ 3 + 1 = 9 := by
  norm_num

/-- 17 = 2⁴+1（家族成员 m=4——发夹尖端沉默位点）。 -/
theorem p2_4 : 2 ^ 4 + 1 = 17 := by
  norm_num

/-- 33 = 2⁵+1（家族成员 m=5——沉默位点）。 -/
theorem p2_5 : 2 ^ 5 + 1 = 33 := by
  norm_num

/-- 65 = 2⁶+1（家族成员 m=6——桥/修正，引用 s65_pow6）。 -/
theorem p2_6 : 2 ^ 6 + 1 = 65 := by
  exact MUFPF.Silence65.s65_pow6

/-- 129 = 2⁷+1（家族成员 m=7——超 k_max 域，观察级巧合登记）。 -/
theorem p2_7 : 2 ^ 7 + 1 = 129 := by
  norm_num

/-- 257 = 2⁸+1（家族成员 m=8——超 k_max 域）。 -/
theorem p2_8 : 2 ^ 8 + 1 = 257 := by
  norm_num

/-- ★ 2^m+1 家族 8 成员联合（截距分子全体 {3,5,9,17,33,65,129,257}）。 -/
theorem family_octet :
    (2 ^ 1 + 1 = 3) ∧ (2 ^ 2 + 1 = 5) ∧ (2 ^ 3 + 1 = 9) ∧ (2 ^ 4 + 1 = 17) ∧
    (2 ^ 5 + 1 = 33) ∧ (2 ^ 6 + 1 = 65) ∧ (2 ^ 7 + 1 = 129) ∧ (2 ^ 8 + 1 = 257) := by
  norm_num

/-! =========================================================
    §2 静默单元家族重合（186：2^m+1 = 8·2^{m−3}+1）
   ========================================================= -/

/-- 9 = 8·1+1（静默单元 k=2⁰）。 -/
theorem silent9 : 8 * 1 + 1 = 9 := by
  norm_num

/-- 17 = 8·2+1（静默单元 k=2¹）。 -/
theorem silent17 : 8 * 2 + 1 = 17 := by
  norm_num

/-- 33 = 8·4+1（静默单元 k=2²）。 -/
theorem silent33 : 8 * 4 + 1 = 33 := by
  norm_num

/-- 65 = 8·8+1（静默单元 k=2³=k_max）。 -/
theorem silent65 : 8 * 8 + 1 = 65 := by
  norm_num

/-- 129 = 8·16+1（静默单元 k=2⁴）。 -/
theorem silent129 : 8 * 16 + 1 = 129 := by
  norm_num

/-- 257 = 8·32+1（静默单元 k=2⁵）。 -/
theorem silent257 : 8 * 32 + 1 = 257 := by
  norm_num

/-- ★ 双家族代数重合 6 实例（2^m+1 = 8·2^{m−3}+1，m=3..8——k 取 2 幂的静默单元子集）。 -/
theorem silent_union :
    (2 ^ 3 + 1 = 8 * 1 + 1) ∧ (2 ^ 4 + 1 = 8 * 2 + 1) ∧ (2 ^ 5 + 1 = 8 * 4 + 1) ∧
    (2 ^ 6 + 1 = 8 * 8 + 1) ∧ (2 ^ 7 + 1 = 8 * 16 + 1) ∧ (2 ^ 8 + 1 = 8 * 32 + 1) := by
  norm_num

/-! =========================================================
    §3 65 四重身份（193 O1/O2 + 192 L2）
   ========================================================= -/

/-- ★ 65 四重身份联合：k_max²+1 = 2⁶+1 = 8·8+1 = a_5（家族 m=6/静默 k=8/框架平方/窗口边界）。 -/
theorem s65_quadruple :
    (k_max ^ 2 + 1 = 65) ∧ (2 ^ 6 + 1 = 65) ∧ (8 * 8 + 1 = 65) := by
  norm_num [k_max_value]

/-! =========================================================
    §4 B*(1) 种子代数闭合（192 L1 决定性 + 194/196）
   ========================================================= -/

/-- ★ 5/7 + 1/65 = 332/455（无修正主值 5/7 + 65 修正——1/B*(1) 精确分解）。 -/
theorem b1_seed_frac : (5 : ℚ) / 7 + 1 / 65 = 332 / 455 := by
  norm_num

/-- ★ 框架表达：1/B*(1) = (k_max−3)/(k_max−1) + 1/(k_max²+1) = 332/455。 -/
theorem b1_seed_kmax :
    ((k_max - 3 : ℚ)) / (k_max - 1) + 1 / (k_max ^ 2 + 1) = 332 / 455 := by
  norm_num [k_max_value]

/-- 455 = 7·5·13（域宽×隔位种子×C 分子）。 -/
theorem b1_den_455 : 7 * 5 * 13 = 455 := by
  norm_num

/-- 332 = 4·(2·41+1)（满格×D 分子线性）。 -/
theorem b1_num_332 : 4 * (2 * 41 + 1) = 332 := by
  norm_num

/-- ★ 1/B*(1) 种子代数：332/455 = [4·(2·41+1)]/[7·5·13]。 -/
theorem b1_seed_algebra :
    (4 * (2 * 41 + 1) : ℚ) / (7 * 5 * 13) = 332 / 455 := by
  norm_num

