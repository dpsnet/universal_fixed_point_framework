/-
# PeriodMapUnificationIdentities.lean — 周期映射族统一（P7-5e-282）

形式化目标（201 资产统一 Lean 化）：

  ★ 周期映射族统一恒等：
     2^{m+2^k}+1 = 2^{2^k}·(2^m+1) − (2^{2^k}−1) = b_{2^k−2}·x − (F_k−2)
  （k=0..3 四映射族；缩放 = 窗口终边界 b_j = 2^{j+2}；平移 = Fermat 窗口宽度 F_k−2——
   188 的 k=3 周期映射（256·x−255）是特例）

  §1 DD1：k=0→2x−1、k=1→4x−3、k=2→16x−15、k=3→256x−255（k×m=1,3,7 实例）；
  §2 DD2：缩放 2^{2^k} = b_{2^k−2}（b_0=4/b_2=16/b_6=256）；
  §3 EE2：单位位 k 序列 = 2^{m−3} 2 进幂连续（k={1,2,4,8,16,32}，m=3..8）；
  §4 EE3：Fermat 素数位置 k=2,32（17→k=2、257→k=32）；
  §5 EE1：合数起边界 k={1,4,8,16}=2^{m−3}（m=3,5,6,7）；
  §6 平移 = F_k−2（k=0..3：1/3/15/255）；
  §7 EE4 对照：65 k=8 vs D(7) 分母 3265 k=408（数值登记）。

★ 诚实边界：
  · DD1/DD2 为代数恒等（201 语义指认候选——"缩放=终边界、平移=Fermat 宽度"是语义层主张）；
  · EE1/EE2/EE3 为定义恒等（k=(a_j−1)/8 直接计算）；
  · EE4 为数值对照登记（65 与 D(7) 域差异，非恒等）。

数值先证伪记录（先证伪再证明，模式 8）：
  - p7_5e282_pycheck.py（sympy 精确）：35/35 全通过、残差 0。

关系链：import FermatFamilyIdentities（281——传递 SilentBittype/SeedAlgebra/PowerTwoSilent）。
-/

import Mathlib.Tactic
import MUFPFormalization.FermatFamilyIdentities

open MUFPF.BottTower

namespace MUFPF.PeriodMapUnification

/-! =========================================================
    §1 DD1 周期映射族统一（k=0..3 × m=1,3,7 实例）
   ========================================================= -/

/-- DD1 k=0（缩放 2、平移 1）：2·3−1 = 2^{1+1}+1（5 = a_1）。 -/
theorem pmap00 : 2 * 3 - 1 = 2 ^ (1 + 1) + 1 := by
  norm_num

/-- DD1 k=0 m=3：2·9−1 = 2^{3+1}+1（17 = a_3）。 -/
theorem pmap03 : 2 * 9 - 1 = 2 ^ (3 + 1) + 1 := by
  norm_num

/-- DD1 k=0 m=7：2·129−1 = 2^{7+1}+1（257 = a_7）。 -/
theorem pmap07 : 2 * 129 - 1 = 2 ^ (7 + 1) + 1 := by
  norm_num

/-- DD1 k=1（缩放 4、平移 3）：4·3−3 = 2^{1+2}+1（9 = a_2）。 -/
theorem pmap10 : 4 * 3 - 3 = 2 ^ (1 + 2) + 1 := by
  norm_num

/-- DD1 k=1 m=7：4·129−3 = 2^{7+2}+1（513 = a_8）。 -/
theorem pmap17 : 4 * 129 - 3 = 2 ^ (7 + 2) + 1 := by
  norm_num

/-- DD1 k=2（缩放 16、平移 15）：16·3−15 = 2^{1+4}+1（33 = a_4）。 -/
theorem pmap20 : 16 * 3 - 15 = 2 ^ (1 + 4) + 1 := by
  norm_num

/-- DD1 k=2 m=7：16·129−15 = 2^{7+4}+1（2049 = a_10）。 -/
theorem pmap27 : 16 * 129 - 15 = 2 ^ (7 + 4) + 1 := by
  norm_num

/-- DD1 k=3（缩放 256、平移 255——188 周期映射特例）：256·3−255 = 2^{1+8}+1（513 = a_8）。 -/
theorem pmap30 : 256 * 3 - 255 = 2 ^ (1 + 8) + 1 := by
  norm_num

/-- DD1 k=3 m=7：256·129−255 = 2^{7+8}+1（32769 = a_15——F_4 位置）。 -/
theorem pmap37 : 256 * 129 - 255 = 2 ^ (7 + 8) + 1 := by
  norm_num

/-- ★ DD1 四映射族联合（m=1 起点 3 → 5/9/33/513：k=0..3 全映射链）。 -/
theorem pmap_union :
    (2 * 3 - 1 = 2 ^ (1 + 1) + 1) ∧ (4 * 3 - 3 = 2 ^ (1 + 2) + 1) ∧
    (16 * 3 - 15 = 2 ^ (1 + 4) + 1) ∧ (256 * 3 - 255 = 2 ^ (1 + 8) + 1) := by
  norm_num

/-! =========================================================
    §2 DD2 缩放 = 2^{2^k} = b_{2^k−2}（b_j = 2^{j+2}）
   ========================================================= -/

/-- DD2 k=1：2^{2¹} = b_0 = 2^{0+2}（4 = 窗口 1 终边界）。 -/
theorem scale_b0 : 2 ^ (2 ^ 1) = 2 ^ (0 + 2) := by
  norm_num

/-- DD2 k=2：2^{2²} = b_2 = 2^{2+2}（16 = 窗口 2 终边界）。 -/
theorem scale_b2 : 2 ^ (2 ^ 2) = 2 ^ (2 + 2) := by
  norm_num

/-- DD2 k=3：2^{2³} = b_6 = 2^{6+2}（256 = 窗口 6 终边界——188 缩放）。 -/
theorem scale_b6 : 2 ^ (2 ^ 3) = 2 ^ (6 + 2) := by
  norm_num

/-- ★ DD2 缩放三实例联合（缩放 = 窗口终边界 b_{2^k−2}）。 -/
theorem scale_union :
    (2 ^ (2 ^ 1) = 2 ^ (0 + 2)) ∧ (2 ^ (2 ^ 2) = 2 ^ (2 + 2)) ∧
    (2 ^ (2 ^ 3) = 2 ^ (6 + 2)) := by
  norm_num

/-! =========================================================
    §3 EE2 单位位 k 序列 = 2^{m−3}（m=3..8，2 进幂连续）
   ========================================================= -/

/-- EE2 m=3：k(a_2=9) = 1 = 2^{3−3}。 -/
theorem k9_1 : (9 - 1) / 8 = 2 ^ (3 - 3) := by
  norm_num

/-- EE2 m=4：k(a_3=17) = 2 = 2^{4−3}。 -/
theorem k17_2 : (17 - 1) / 8 = 2 ^ (4 - 3) := by
  norm_num

/-- EE2 m=5：k(a_4=33) = 4 = 2^{5−3}。 -/
theorem k33_4 : (33 - 1) / 8 = 2 ^ (5 - 3) := by
  norm_num

/-- EE2 m=6：k(a_5=65) = 8 = 2^{6−3}。 -/
theorem k65_8 : (65 - 1) / 8 = 2 ^ (6 - 3) := by
  norm_num

/-- EE2 m=7：k(a_6=129) = 16 = 2^{7−3}。 -/
theorem k129_16 : (129 - 1) / 8 = 2 ^ (7 - 3) := by
  norm_num

/-- EE2 m=8：k(a_7=257) = 32 = 2^{8−3}。 -/
theorem k257_32 : (257 - 1) / 8 = 2 ^ (8 - 3) := by
  norm_num

/-- ★ EE2 单位位 k 序列六成员联合（{1,2,4,8,16,32} = 2^{m−3} 2 进幂连续）。 -/
theorem kunit_union :
    ((9 - 1) / 8 = 2 ^ (3 - 3)) ∧ ((17 - 1) / 8 = 2 ^ (4 - 3)) ∧
    ((33 - 1) / 8 = 2 ^ (5 - 3)) ∧ ((65 - 1) / 8 = 2 ^ (6 - 3)) ∧
    ((129 - 1) / 8 = 2 ^ (7 - 3)) ∧ ((257 - 1) / 8 = 2 ^ (8 - 3)) := by
  norm_num

/-! =========================================================
    §4 EE3 Fermat 素数位置 k=2,32
   ========================================================= -/

/-- EE3：Fermat 素数 17（=F_2）位置 k = 2。 -/
theorem fk_pos2 : (17 - 1) / 8 = 2 ^ 1 := by
  norm_num

/-- EE3：Fermat 素数 257（=F_3）位置 k = 32。 -/
theorem fk_pos32 : (257 - 1) / 8 = 2 ^ 5 := by
  norm_num

/-- ★ EE3 Fermat 位置联合（素数成员位于 2 进幂 k 位置）。 -/
theorem fermat_pos_union : (17 - 1) / 8 = 2 ^ 1 ∧ (257 - 1) / 8 = 2 ^ 5 := by
  norm_num

/-! =========================================================
    §5 EE1 合数起边界 k={1,4,8,16}=2^{m−3}（m=3,5,6,7）
   ========================================================= -/

/-- ★ EE1 合数起边界 k 联合（合数成员 a_j 的 k = 2^{m−3}——{1,4,8,16}）。 -/
theorem composite_k_union :
    ((9 - 1) / 8 = 2 ^ (3 - 3)) ∧ ((33 - 1) / 8 = 2 ^ (5 - 3)) ∧
    ((65 - 1) / 8 = 2 ^ (6 - 3)) ∧ ((129 - 1) / 8 = 2 ^ (7 - 3)) := by
  norm_num

/-! =========================================================
    §6 平移 = F_k−2（k=0..3：1/3/15/255）
   ========================================================= -/

/-- ★ 平移四成员联合（2^{2^k}−1 = F_k−2——Fermat 窗口宽度）。 -/
theorem shift_union :
    (2 ^ (2 ^ 0) - 1 = 3 - 2) ∧ (2 ^ (2 ^ 1) - 1 = 5 - 2) ∧
    (2 ^ (2 ^ 2) - 1 = 17 - 2) ∧ (2 ^ (2 ^ 3) - 1 = 257 - 2) := by
  norm_num

/-! =========================================================
    §7 EE4 对照：65 k=8 vs D(7) 分母 k=408（数值登记）
   ========================================================= -/

/-- ★ EE4 对照联合（65 域 k=8 vs D(7) 分母 3265 的 k=408——域差异登记）。 -/
theorem ee4_contrast : (65 - 1) / 8 = 8 ∧ (3265 - 1) / 8 = 408 := by
  norm_num

end MUFPF.PeriodMapUnification
