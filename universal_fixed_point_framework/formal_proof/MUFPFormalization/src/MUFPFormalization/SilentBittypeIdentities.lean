import Mathlib.Tactic
import MUFPFormalization.SeedAlgebraCoefficientIdentities

open MUFPF.BottTower

namespace MUFPF.SilentBittype

/-! =========================================================
    §1 相邻双位家族（190 ①：k=3·2^p——窗口对合常数 c_2..c_6）
   ========================================================= -/

/-- 25 = 8·3+1（相邻双位 p=0，k=3=3·2⁰——窗口对合常数 c_2）。 -/
theorem adj25 : 8 * 3 + 1 = 25 := by
  norm_num

/-- 49 = 8·6+1（相邻双位 p=1，k=6=3·2¹——c_3）。 -/
theorem adj49 : 8 * 6 + 1 = 49 := by
  norm_num

/-- 97 = 8·12+1（相邻双位 p=2，k=12=3·2²——c_4）。 -/
theorem adj97 : 8 * 12 + 1 = 97 := by
  norm_num

/-- 193 = 8·24+1（相邻双位 p=3，k=24=3·2³——c_5）。 -/
theorem adj193 : 8 * 24 + 1 = 193 := by
  norm_num

/-- 385 = 8·48+1（相邻双位 p=4，k=48=3·2⁴——c_6）。 -/
theorem adj385 : 8 * 48 + 1 = 385 := by
  norm_num

/-- ★ 相邻双位 5 成员联合 {25,49,97,193,385}（k=3·2^p，p=0..4）。 -/
theorem adj_union :
    (8 * 3 + 1 = 25) ∧ (8 * 6 + 1 = 49) ∧ (8 * 12 + 1 = 97) ∧
    (8 * 24 + 1 = 193) ∧ (8 * 48 + 1 = 385) := by
  norm_num

/-! =========================================================
    §2 隔位双位家族（190 ①：k=5·2^p——"101" 位型）
   ========================================================= -/

/-- 41 = 8·5+1（隔位双位 p=0，k=5——D 分子 = k_max·5+1 第二通道）。 -/
theorem gap41 : 8 * 5 + 1 = 41 := by
  norm_num

/-- 81 = 8·10+1（隔位双位 p=1，k=10——D₉ 超对合域常数）。 -/
theorem gap81 : 8 * 10 + 1 = 81 := by
  norm_num

/-- ★ 隔位双位 2 成员联合 {41,81}（k=5·2^p，p=0,1）。 -/
theorem gap_union : (8 * 5 + 1 = 41) ∧ (8 * 10 + 1 = 81) := by
  norm_num

/-! =========================================================
    §3 单位位家族（190 ①：k=2^p——278 silent_union 跨文件引用）
   ========================================================= -/

/-- ★ 单位位 6 成员联合（2^m+1 家族重合面——引用 silent_union）。 -/
theorem unit_union :
    (2 ^ 3 + 1 = 8 * 1 + 1) ∧ (2 ^ 4 + 1 = 8 * 2 + 1) ∧ (2 ^ 5 + 1 = 8 * 4 + 1) ∧
    (2 ^ 6 + 1 = 8 * 8 + 1) ∧ (2 ^ 7 + 1 = 8 * 16 + 1) ∧ (2 ^ 8 + 1 = 8 * 32 + 1) := by
  exact MUFPF.PowerTwoSilent.silent_union

/-! =========================================================
    §4 框架身份（25/49/41）
   ========================================================= -/

/-- 25 = (k_max−3)²（N' 平方——相邻双位 k=3 框架身份）。 -/
theorem sq25 : (k_max - 3) ^ 2 = 25 := by
  norm_num [k_max_value]

/-- 49 = (k_max−1)²（缺口域倒数平方——相邻双位 k=6 框架身份）。 -/
theorem sq49 : (k_max - 1) ^ 2 = 49 := by
  norm_num [k_max_value]

/-- ★ 位型-框架身份联合（25 = N'²、49 = (k_max−1)²、41 = k_max·5+1）。 -/
theorem framework_union :
    ((k_max - 3) ^ 2 = 25) ∧ ((k_max - 1) ^ 2 = 49) ∧ (k_max * 5 + 1 = 41) := by
  norm_num [k_max_value]

/-! =========================================================
    §5 13 成员位型分类联合（190 ①："13 静默单元位型分类"）
   ========================================================= -/

/-- ★ 13 成员位型分类全体：单位位 6（k=2^p）+ 相邻双位 5（k=3·2^p）+ 隔位双位 2（k=5·2^p）。 -/
theorem bittype_13 :
    (8 * 1 + 1 = 9) ∧ (8 * 2 + 1 = 17) ∧ (8 * 4 + 1 = 33) ∧ (8 * 8 + 1 = 65) ∧
    (8 * 16 + 1 = 129) ∧ (8 * 32 + 1 = 257) ∧
    (8 * 3 + 1 = 25) ∧ (8 * 6 + 1 = 49) ∧ (8 * 12 + 1 = 97) ∧
    (8 * 24 + 1 = 193) ∧ (8 * 48 + 1 = 385) ∧
    (8 * 5 + 1 = 41) ∧ (8 * 10 + 1 = 81) := by
  norm_num

/-! =========================================================
    §6 窗口对合常数序列（189：c_j = 8k_j+1——c_2..c_6 引用 §1）
   ========================================================= -/

/-- c_1 = 8·1+1 = 9（窗口 1 对合常数——单位位 k=1，起点异类）。 -/
theorem cwin1 : 8 * 1 + 1 = 9 := by
  norm_num

/-- ★ 窗口对合常数序列联合：c_j = 8k_j+1，k_j={1,3,6,12,24,48}（j=1..6）。 -/
theorem cwin_union :
    (8 * 1 + 1 = 9) ∧ (8 * 3 + 1 = 25) ∧ (8 * 6 + 1 = 49) ∧
    (8 * 12 + 1 = 97) ∧ (8 * 24 + 1 = 193) ∧ (8 * 48 + 1 = 385) := by
  norm_num

end MUFPF.SilentBittype
