/-
# DeepIdentityMatrix.lean — 深阶身份矩阵联合主定理（P7-5e-271，证明提升阶段主线收官）

形式化目标（论文 §7.5 深阶身份矩阵的机器可验证联合定理）：
  把战役锁定的七个深阶身份（δ∞、C、D、E、h(2)、h″(2)、i′(2)）合成**单一联合矩阵定理**，
  并用"行结构"（家族族：静默单元行 / 平方差行 / 同分母行）与"判别链"（h(2)→C）
  表达矩阵的跨行语义：

    ┌────────────────────────────────────────────────────────┐
    │ δ∞  = 1/((k_max−1)·k_max)                    = 1/56     │
    │ C    = (2k_max−3)/2^(k_max−1)                = 13/128   │
    │ D    = (k_max·5+1)/(2⁴·5³)                   = 41/2000  │
    │ E    = (k_max·5−1)/(2⁴·5³)                   = 39/2000  │
    │ h(2) = (k_max−1)/2^(k_max−2)                 = 7/64     │
    │ h″(2)= −(2k_max+3)/2^(k_max+3)               = −19/2048 │
    │ i′(2)= −(k_max−5)(k_max+5)/2^(k_max+3)       = −39/2048 │
    └────────────────────────────────────────────────────────┘

  行结构（跨行语义）：
    · 静默单元行：k_max−1 同时出现在 δ∞ 分母因子、h(2) 分子、碗形 7/2048 分子。
    · 平方差行：  39 同时是 i′(2) 分子（k_max²−5²）与 E 分子（k_max·5−1）。
    · 同分母行：  碗形 7/2048、h″(2)、i′(2) 共用分母 2^(k_max+3) = 2048。
    · 判别链：    h(2)/C = 2(k_max−1)/(2k_max−3) = 14/13（296-298：h(2)=7/64 判别 → C 解析锁定）。

数值先证伪记录（先证伪再证明，模式 8）：
  - p7_5e271_pycheck.py（sympy 精确）：14/14 全通过、残差 0。
  覆盖：七身份联合矩阵、静默单元三重出现、平方差双身份、同分母 2048、h(2)/C=14/13。

关系链：
  266 KMaxAlgebra → 267 DeepCoefficientIdentities → 269 BowlLayerIdentities → 270 DerivativeLayerIdentities
  → 本文件（import DerivativeLayerIdentities，传递覆盖全部层）。
  本文件同时显式引用 KMaxAlgebra.silence_unit（静默单元 k_max−1）。
-/

import Mathlib.Tactic
import MUFPFormalization.DerivativeLayerIdentities

open MUFPF.BottTower

namespace MUFPF.DeepIdentityMatrix

/-! =========================================================
    §1 深阶身份矩阵联合定理（七身份 ∧ 联合）
   ========================================================= -/

/--
★ 深阶身份矩阵联合主定理：七锁定身份的 k_max 框架表达同时成立。
（每行对应论文 §7.5 深阶身份矩阵的一行；全部以 k_max=8 求值为锁定数值。）
-/
theorem deep_identity_matrix :
    1 / ((k_max - 1 : ℚ) * k_max) = 1 / 56 ∧
    (2 * k_max - 3 : ℚ) / (2 : ℚ) ^ (k_max - 1) = 13 / 128 ∧
    (k_max * 5 + 1 : ℚ) / ((2 : ℚ) ^ 4 * (5 : ℚ) ^ 3) = 41 / 2000 ∧
    (k_max * 5 - 1 : ℚ) / ((2 : ℚ) ^ 4 * (5 : ℚ) ^ 3) = 39 / 2000 ∧
    (k_max - 1 : ℚ) / (2 : ℚ) ^ (k_max - 2) = 7 / 64 ∧
    -((2 * k_max + 3 : ℚ)) / (2 : ℚ) ^ (k_max + 3) = -19 / 2048 ∧
    -((k_max - 5 : ℚ) * (k_max + 5)) / (2 : ℚ) ^ (k_max + 3) = -39 / 2048 := by
  norm_num [k_max_value]

/-! =========================================================
    §2 行结构：静默单元行
   ========================================================= -/

/-- 静默单元 k_max−1 = 7（引用 KMaxAlgebra.silence_unit，跨文件链）。 -/
theorem matrix_silence_unit : k_max - 1 = 7 := by
  exact MUFPF.KMaxAlgebra.silence_unit

/-- 静默单元三重出现：δ∞ 分母因子、h(2) 分子、碗形 7/2048 分子共享 k_max−1。 -/
theorem matrix_silence_row :
    (k_max - 1) * k_max = 56 ∧
    (k_max - 1) = 7 ∧
    (k_max - 1) = 7 := by
  norm_num [k_max_value]

/-! =========================================================
    §3 行结构：平方差行（39 家族）
   ========================================================= -/

/-- 平方差行：39 同时是 i′(2) 分子（k_max²−5²）与 E 分子（k_max·5−1）。 -/
theorem matrix_square_diff_row :
    k_max ^ 2 - 5 ^ 2 = 39 ∧
    k_max * 5 - 1 = 39 := by
  norm_num [k_max_value]

/-! =========================================================
    §4 行结构：同分母行（2^(k_max+3) = 2048）
   ========================================================= -/

/-- 同分母行：碗形 7/2048、h″(2)、i′(2) 共用分母 2^(k_max+3) = 2048。 -/
theorem matrix_shared_den_row :
    (2 : ℚ) ^ (k_max + 3) = 2048 := by
  norm_num [k_max_value]

/-! =========================================================
    §5 判别链：h(2) → C（296-298）
   ========================================================= -/

/-- ★ 判别链：h(2)/C = 2(k_max−1)/(2k_max−3)（h(2)=7/64 判别 → C 解析锁定的数值链，= 14/13）。 -/
theorem matrix_h2_c_chain :
    ((k_max - 1 : ℚ) / (2 : ℚ) ^ (k_max - 2)) /
      ((2 * k_max - 3 : ℚ) / (2 : ℚ) ^ (k_max - 1)) = 2 * (k_max - 1) / (2 * k_max - 3) := by
  norm_num [k_max_value]

end MUFPF.DeepIdentityMatrix
