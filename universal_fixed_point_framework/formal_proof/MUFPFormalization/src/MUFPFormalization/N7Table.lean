import Mathlib.Data.Real.Basic
import Mathlib.Data.Int.Basic
import Mathlib.Tactic

namespace N7Table

/-- 16 因子符号 → 位编码键（位 i = 1 ⟺ s i = 1；权重 2^i） -/
def encode16 (s : Fin 16 → ℤ) : Nat :=
  (if s 0 = 1 then 1 else 0) + (if s 1 = 1 then 2 else 0) + (if s 2 = 1 then 4 else 0) + (if s 3 = 1 then 8 else 0) + (if s 4 = 1 then 16 else 0) + (if s 5 = 1 then 32 else 0) + (if s 6 = 1 then 64 else 0) + (if s 7 = 1 then 128 else 0) + (if s 8 = 1 then 256 else 0) + (if s 9 = 1 then 512 else 0) + (if s 10 = 1 then 1024 else 0) + (if s 11 = 1 then 2048 else 0) + (if s 12 = 1 then 4096 else 0) + (if s 13 = 1 then 8192 else 0) + (if s 14 = 1 then 16384 else 0) + (if s 15 = 1 then 32768 else 0)

/-- 线性查找（结构递归；未命中返回 0） -/
def lookup (t : List (Nat × ℤ)) (k : Nat) : ℤ := 
  match t with
  | [] => 0
  | (k', v) :: tl => if k = k' then v else lookup tl k


