/-!
# 二阶项（净冻结）Lean 锚——S114（2026-10-27）

二阶修正项 σ⁵ − e^{−16}（E_τ^C 三阶截断）的定性界：
净冻结 = 代数冻结（σ⁵）− 超越残漏（e^{−16}）——为正（冻结测度 > 残漏测度）
- σ⁵ = (1/15)⁵ = 1/759375（静默⁵——全态 16 减单位元 15 的静默幂）
- e^{−16} = Real.exp (−16)（全态泊松残漏——16 窗口各漏 e^{−1}）
- 定理 sigma5_gt_exp_neg16：σ⁵ > e^{−16} ⇔ e^{16} > 15⁵ = 759375
- 路径：e 从 EGF 截断下界（exp_bound at 1——n=6：Σ_{m<6}1/m! = 163/60）
-/

-- 代数恒等锚：σ⁵ = (2⁴−1)⁻⁵（全态 16 减单位元 = 轨道计数 15 的静默幂）
theorem sigma5_of_full_state_minus_one :
    ((1 : ℝ) / (2 ^ 4 - 1)) ^ 5 = (1 : ℝ) / 759375 := by
  norm_num

-- 幂计算锚：15⁵ = 759375（轨道计数的静默幂分母）
theorem orbit_count_pow_five : (15 : ℝ) ^ 5 = 759375 := by
  norm_num

-- EGF 截断下界：e = exp 1 > 271/100（exp_bound at 1, n=6——Σ_{m<6} 1/m! = 163/60）
theorem exp_one_gt_271_100 : Real.exp 1 > (271 : ℝ) / 100 := by
  have hb := Real.exp_bound (x := (1 : ℝ)) (by norm_num : |(1 : ℝ)| ≤ 1) (by norm_num : 0 < 6)
  have hsum : (Finset.range 6).sum (fun m => (1 : ℝ) ^ m / (m.factorial : ℝ)) = 163 / 60 := by
    norm_num [Finset.sum_range_succ]
  have hb' : |Real.exp 1 - (163 : ℝ) / 60| ≤ 7 / 4320 := by
    rw [hsum] at hb
    norm_num at hb ⊢
    exact hb
  -- |exp 1 − 163/60| ≤ 7/4320 ⟹ exp 1 ≥ 163/60 − 7/4320
  have hlo : (163 : ℝ) / 60 - 7 / 4320 ≤ Real.exp 1 := by
    rw [abs_sub_le_iff] at hb'
    linarith
  have h271 : (271 : ℝ) / 100 < (163 : ℝ) / 60 - 7 / 4320 := by
    norm_num
  exact lt_of_lt_of_le h271 hlo

-- 定性界：σ⁵ > e^{−16}（净冻结为正——冻结测度超过全态残漏）
-- e^{−16} < 1/15⁵ ⇔ e^{16} > 15⁵（exp_neg 倒数 + 正数比较）
theorem sigma5_gt_exp_neg16 :
    ((1 : ℝ) / 15) ^ 5 > Real.exp (-16) := by
  rw [Real.exp_neg]
  rw [div_pow]
  norm_num -- (1/15)^5 → 1/15^5
  rw [← one_div] -- (Real.exp 16)⁻¹ → 1 / Real.exp 16
  apply one_div_lt_one_div_of_lt
  · -- 0 < 15^5
    norm_num
  · -- 15^5 < e^{16}
    have h16 : Real.exp (16 : ℝ) = (Real.exp 1) ^ 16 := by
      rw [show (16 : ℝ) = (↑16 : ℕ) * 1 by norm_num]
      exact Real.exp_nat_mul 1 16
    -- (exp 1)^{16} > (271/100)^{16}（pow_lt_pow_left₀）
    have hpow : (Real.exp 1) ^ 16 > ((271 : ℝ) / 100) ^ 16 := by
      exact pow_lt_pow_left₀ exp_one_gt_271_100 (by norm_num : 0 ≤ (271 : ℝ) / 100)
        (by norm_num : 16 ≠ 0)
    -- (271/100)^{16} > 759375（norm_num 大数幂）
    have h271p : ((271 : ℝ) / 100) ^ 16 > (759375 : ℝ) := by
      norm_num
    have hchain : Real.exp (16 : ℝ) > (759375 : ℝ) := by
      rw [h16]
      exact lt_trans h271p hpow
    -- 目标 759375 < Real.exp 16——hchain 正是
    exact hchain

