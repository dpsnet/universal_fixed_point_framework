import Mathlib.Tactic
import MUFPFormalization.PeriodMapUnificationIdentities

open MUFPF.BottTower

namespace MUFPF.WindowShiftFermat4

/-! =========================================================
    §1 FF1 窗口平移 M(a_j)=a_{j+8}（256·a_j−255）
   ========================================================= -/

/-- FF1：a_0=3 → a_8（256·3−255 = 513 = 2^{8+1}+1）。 -/
theorem shift_a0_a8 : 256 * 3 - 255 = 2 ^ 9 + 1 := by
  norm_num

/-- FF1：a_3=17 → a_11（256·17−255 = 4097 = 2^{11+1}+1）。 -/
theorem shift_a3_a11 : 256 * 17 - 255 = 2 ^ 12 + 1 := by
  norm_num

/-- FF1 ★：a_7=257 → a_15（256·257−255 = 65537 = F_4）。 -/
theorem shift_a7_a15 : 256 * 257 - 255 = 65537 := by
  norm_num

/-- ★ FF1 平移三实例联合（a_j → a_{j+8}：513/4097/65537）。 -/
theorem ff1_union :
    (256 * 3 - 255 = 2 ^ 9 + 1) ∧ (256 * 17 - 255 = 2 ^ 12 + 1) ∧
    (256 * 257 - 255 = 65537) := by
  norm_num

/-! =========================================================
    §2 FF2 窗口对合常数平移 M(c_j)=c_{j+8}（k→256k）
   ========================================================= -/

/-- FF2：k=1 → 256k=256：c' = 2049（= 2^{11}+1 = a_10——平移入单位位）。 -/
theorem cwin_shift1 : 8 * (256 * 1) + 1 = 2049 := by
  norm_num

/-- FF2：k=3 → 256k=768：c' = 6145。 -/
theorem cwin_shift3 : 8 * (256 * 3) + 1 = 6145 := by
  norm_num

/-- FF2：k=6 → 256k=1536：c' = 12289。 -/
theorem cwin_shift6 : 8 * (256 * 6) + 1 = 12289 := by
  norm_num

/-- FF2：k=12 → 256k=3072：c' = 24577。 -/
theorem cwin_shift12 : 8 * (256 * 12) + 1 = 24577 := by
  norm_num

/-- FF2：k=24 → 256k=6144：c' = 49153。 -/
theorem cwin_shift24 : 8 * (256 * 24) + 1 = 49153 := by
  norm_num

/-- FF2：k=48 → 256k=12288：c' = 98305。 -/
theorem cwin_shift48 : 8 * (256 * 48) + 1 = 98305 := by
  norm_num

/-- ★ FF2 六成员联合（窗口对合常数 k→256k 平移保持）。 -/
theorem cwin_shift_union :
    (8 * (256 * 1) + 1 = 2049) ∧ (8 * (256 * 3) + 1 = 6145) ∧
    (8 * (256 * 6) + 1 = 12289) ∧ (8 * (256 * 12) + 1 = 24577) ∧
    (8 * (256 * 24) + 1 = 49153) ∧ (8 * (256 * 48) + 1 = 98305) := by
  norm_num

/-! =========================================================
    §3 FF3 ★ M(b_j)=b_{j+8}−255 = 静默单元（k=32·(2^{j+2}−1)）
   ========================================================= -/

/-- FF3 j=1：b_9−255 = 2^{11}−255 = 1793 = 8·224+1（k=32·(2³−1)）。 -/
theorem mb1 : 2 ^ 11 - 255 = 8 * (32 * (2 ^ 3 - 1)) + 1 := by
  norm_num

/-- FF3 j=2：b_10−255 = 2^{12}−255 = 3841 = 8·480+1（k=32·(2⁴−1)）。 -/
theorem mb2 : 2 ^ 12 - 255 = 8 * (32 * (2 ^ 4 - 1)) + 1 := by
  norm_num

/-- FF3 j=3：b_11−255 = 2^{13}−255 = 7937 = 8·992+1（k=32·(2⁵−1)）。 -/
theorem mb3 : 2 ^ 13 - 255 = 8 * (32 * (2 ^ 5 - 1)) + 1 := by
  norm_num

/-- FF3 j=4：b_12−255 = 2^{14}−255 = 16129 = 8·2016+1（k=32·(2⁶−1)）。 -/
theorem mb4 : 2 ^ 14 - 255 = 8 * (32 * (2 ^ 6 - 1)) + 1 := by
  norm_num

/-- FF3 j=5：b_13−255 = 2^{15}−255 = 32513 = 8·4064+1（k=32·(2⁷−1)）。 -/
theorem mb5 : 2 ^ 15 - 255 = 8 * (32 * (2 ^ 7 - 1)) + 1 := by
  norm_num

/-- FF3 j=6：b_14−255 = 2^{16}−255 = 65281 = 8·8160+1（k=32·(2⁸−1)）。 -/
theorem mb6 : 2 ^ 16 - 255 = 8 * (32 * (2 ^ 8 - 1)) + 1 := by
  norm_num

/-- ★ FF3 六成员联合（M(b_j) = b_{j+8}−255 = 静默单元 8k+1，k 为 Mersenne 左移 32·(2^{j+2}−1)）。 -/
theorem mb_union :
    (2 ^ 11 - 255 = 8 * (32 * (2 ^ 3 - 1)) + 1) ∧
    (2 ^ 12 - 255 = 8 * (32 * (2 ^ 4 - 1)) + 1) ∧
    (2 ^ 13 - 255 = 8 * (32 * (2 ^ 5 - 1)) + 1) ∧
    (2 ^ 14 - 255 = 8 * (32 * (2 ^ 6 - 1)) + 1) ∧
    (2 ^ 15 - 255 = 8 * (32 * (2 ^ 7 - 1)) + 1) ∧
    (2 ^ 16 - 255 = 8 * (32 * (2 ^ 8 - 1)) + 1) := by
  norm_num

/-! =========================================================
    §4 GG ★ F_4 预言：65537 = a_15 素数
   ========================================================= -/

/-- GG：F_4 = 2^{2⁴}+1 = 65537。 -/
theorem f4_val : 2 ^ (2 ^ 4) + 1 = 65537 := by
  norm_num

/-- GG：F_4 = a_15（2^{15+1}+1——窗口起边界 j=15）。 -/
theorem f4_a15 : 2 ^ (15 + 1) + 1 = 65537 := by
  norm_num

/-- GG ★：F_4 = 256·a_7−255（FF1 平移链终点 a_7→a_15）。 -/
theorem f4_shift : 256 * 257 - 255 = 65537 := by
  norm_num

/-- GG ★：F_4 = 65537 是素数（norm_num 机器验证）。 -/
theorem f4_prime : Nat.Prime 65537 := by
  norm_num

/-- GG：F_4 的位型位置 k = (65537−1)/8 = 8192 = 2^{13}（2 进幂位置连续：32→8192）。 -/
theorem f4_k : (65537 - 1) / 8 = 2 ^ 13 := by
  norm_num

/-! =========================================================
    §5 GG ★ F_5 预言：4294967297 = 641·6700417 合数（Euler）
   ========================================================= -/

/-- GG：F_5 = 2^{2⁵}+1 = 4294967297。 -/
theorem f5_val : 2 ^ (2 ^ 5) + 1 = 4294967297 := by
  norm_num

/-- GG ★：F_5 = 641·6700417（Euler 经典分解）。 -/
theorem f5_fac : 4294967297 = 641 * 6700417 := by
  norm_num

/-- GG ★：F_5 = 4294967297 是合数（norm_num 素性判定：641 因子）。 -/
theorem f5_composite : ¬ Nat.Prime 4294967297 := by
  norm_num

/-! =========================================================
    §6 素数骨架 m=16 截止（F_0..F_4 素、F_5 合——观察登记）
   ========================================================= -/

/-- ★ 素数骨架联合（F_0..F_4 全素、F_5 合数——2 进组织无限 vs 素数骨架 m=16 截止）。 -/
theorem skeleton_union :
    Nat.Prime 3 ∧ Nat.Prime 5 ∧ Nat.Prime 17 ∧ Nat.Prime 257 ∧
    Nat.Prime 65537 ∧ ¬ Nat.Prime 4294967297 := by
  constructor
  · exact MUFPF.FermatFamily.prime3
  · constructor
    · exact MUFPF.FermatFamily.prime5
    · constructor
      · exact MUFPF.FermatFamily.prime17
      · constructor
        · exact MUFPF.FermatFamily.prime257
        · constructor
          · exact f4_prime
          · exact f5_composite

end MUFPF.WindowShiftFermat4
