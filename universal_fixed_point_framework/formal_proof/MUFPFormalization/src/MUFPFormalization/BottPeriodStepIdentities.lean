import Mathlib.Tactic
import MUFPFormalization.WindowShiftFermat4Identities

namespace MUFPF.BottPeriodStep

/-! =========================================================
    §1 HH ★ 窗口平移 = Bott 周期步进（一般化 283 三实例）
   ========================================================= -/

/-- HH ★ 一般乘法恒等：256·(2^{j+1}+1) = 2^{j+9} + 256（2^8 左移 = Bott 步进 8 的代数核）。 -/
theorem hh_step_mul (j : ℕ) : 256 * (2 ^ (j + 1) + 1) = 2 ^ (j + 9) + 256 := by
  rw [show (256 : ℕ) = 2 ^ 8 by norm_num]
  have hpow : 2 ^ 8 * 2 ^ (j + 1) = 2 ^ (j + 9) := by
    rw [← pow_add]
    congr 1
    omega
  calc
    2 ^ 8 * (2 ^ (j + 1) + 1) = 2 ^ 8 * 2 ^ (j + 1) + 2 ^ 8 := by ring
    _ = 2 ^ (j + 9) + 2 ^ 8 := by rw [hpow]
    _ = 2 ^ (j + 9) + 256 := by norm_num

/-- HH ★★ 一般平移定理：2^{j+9}+1 = 256·(2^{j+1}+1)−255（283 的 a_0→a_8、a_3→a_11、a_7→a_15 三实例的全链升格）。 -/
theorem hh_step_shift (j : ℕ) : 2 ^ (j + 9) + 1 = 256 * (2 ^ (j + 1) + 1) - 255 := by
  calc
    2 ^ (j + 9) + 1 = 2 ^ (j + 9) + (256 - 255) := by norm_num
    _ = (2 ^ (j + 9) + 256) - 255 := by
      have hsub : (2 ^ (j + 9) + 256) - 255 = 2 ^ (j + 9) + (256 - 255) :=
        Nat.add_sub_assoc (by norm_num : (255 : ℕ) ≤ 256) (2 ^ (j + 9))
      exact hsub.symm
    _ = 256 * (2 ^ (j + 1) + 1) - 255 := by
      exact congrArg (fun x => x - 255) (hh_step_mul j).symm

/-- HH 平移关键实例联合（a_0→a_8 513、a_3→a_11 4097、a_7→a_15 65537——283 特化回验）。 -/
theorem hh_step_instances :
    (256 * 3 - 255 = 513) ∧ (256 * 17 - 255 = 4097) ∧ (256 * 257 - 255 = 65537) := by
  norm_num

/-! =========================================================
    §2 HH 静默类封闭：2^{m+8}+1 ≡ 1 mod 8
   ========================================================= -/

/-- HH ★ 一般 mod 定理：(2^{j+9}+1) % 8 = 1（2 进幂 8 阶湮灭 → 平移后仍静默类）。 -/
theorem hh_mod8 (j : ℕ) : (2 ^ (j + 9) + 1) % 8 = 1 := by
  have h : 2 ^ (j + 9) = 512 * 2 ^ j := by
    rw [show (512 : ℕ) = 2 ^ 9 by norm_num, ← pow_add]
    congr 1
    omega
  rw [h]
  have hmod : (512 * 2 ^ j + 1) % 8 = 1 := by
    rw [show (512 : ℕ) = 8 * 64 by norm_num]
    have hmm : 8 * 64 * 2 ^ j = 8 * (64 * 2 ^ j) := by ring
    rw [hmm]
    have heq : 8 * (64 * 2 ^ j) + 1 = 1 + (64 * 2 ^ j) * 8 := by ring
    rw [heq]
    simpa using Nat.add_mul_mod_self_left 1 8 (64 * 2 ^ j)
  exact hmod

/-- HH 静默类实例（m=1..6 的 2^{m+8}+1 全 ≡1 mod 8）。 -/
theorem hh_mod8_instances :
    ((2 ^ 9 + 1) % 8 = 1) ∧ ((2 ^ 10 + 1) % 8 = 1) ∧ ((2 ^ 11 + 1) % 8 = 1) ∧
    ((2 ^ 12 + 1) % 8 = 1) ∧ ((2 ^ 13 + 1) % 8 = 1) ∧ ((2 ^ 14 + 1) % 8 = 1) := by
  norm_num

/-! =========================================================
    §3 HH 例外不跨周期（m=1,3）——D(m) 数值登记
   ========================================================= -/

/-- HH 例外登记：D(1)=10≡2、D(3)=93≡5 不跨周期（静默类例外）；D(9)=16641≡1、D(11)=80897≡1 回静默类。 -/
theorem hh_exceptions :
    (10 : ℕ) % 8 = 2 ∧ (93 : ℕ) % 8 = 5 ∧ 16641 % 8 = 1 ∧ 80897 % 8 = 1 := by
  norm_num

/-! =========================================================
    §4 II2 窗口常数位型 k_j = 3·2^{j−2}（相邻双位）
   ========================================================= -/

/-- II2：k_2=3（3·2^0）、k_3=6（3·2^1）——窗口常数位型起点。 -/
theorem ii2_k2 : 3 * 2 ^ 0 = 3 := by
  norm_num

/-- II2：k_3=6。 -/
theorem ii2_k3 : 3 * 2 ^ 1 = 6 := by
  norm_num

/-- II2：k_4=12。 -/
theorem ii2_k4 : 3 * 2 ^ 2 = 12 := by
  norm_num

/-- II2：k_5=24。 -/
theorem ii2_k5 : 3 * 2 ^ 3 = 24 := by
  norm_num

/-- II2：k_6=48。 -/
theorem ii2_k6 : 3 * 2 ^ 4 = 48 := by
  norm_num

/-- II2：k_7=96。 -/
theorem ii2_k7 : 3 * 2 ^ 5 = 96 := by
  norm_num

/-- ★ II2 六成员联合（窗口常数位型 {3,6,12,24,48,96} = 3·2^{j−2}，j=2..7）。 -/
theorem ii2_union :
    (3 * 2 ^ 0 = 3) ∧ (3 * 2 ^ 1 = 6) ∧ (3 * 2 ^ 2 = 12) ∧
    (3 * 2 ^ 3 = 24) ∧ (3 * 2 ^ 4 = 48) ∧ (3 * 2 ^ 5 = 96) := by
  norm_num

/-! =========================================================
    §5 II1 M(b_j) 静默 k = 32·(2^{j+2}−1)（Mersenne 左移）
   ========================================================= -/

/-- II1：M(b_j) 显式 k 值恒等（{224,480,992,2016,4064,8160}——283 mb_union 的 k 侧显式化）。 -/
theorem ii1_kvalues :
    (32 * (2 ^ 3 - 1) = 224) ∧ (32 * (2 ^ 4 - 1) = 480) ∧
    (32 * (2 ^ 5 - 1) = 992) ∧ (32 * (2 ^ 6 - 1) = 2016) ∧
    (32 * (2 ^ 7 - 1) = 4064) ∧ (32 * (2 ^ 8 - 1) = 8160) := by
  norm_num

/-- ★ 双族并置对照：Mersenne 左移 k（II1）vs 相邻双位 k（II2）——六成员两两并存。 -/
theorem ii_dual_union :
    (32 * (2 ^ 3 - 1) = 224 ∧ 3 * 2 ^ 0 = 3) ∧
    (32 * (2 ^ 4 - 1) = 480 ∧ 3 * 2 ^ 1 = 6) ∧
    (32 * (2 ^ 5 - 1) = 992 ∧ 3 * 2 ^ 2 = 12) ∧
    (32 * (2 ^ 6 - 1) = 2016 ∧ 3 * 2 ^ 3 = 24) ∧
    (32 * (2 ^ 7 - 1) = 4064 ∧ 3 * 2 ^ 4 = 48) ∧
    (32 * (2 ^ 8 - 1) = 8160 ∧ 3 * 2 ^ 5 = 96) := by
  norm_num

/-! =========================================================
    §6 II3 ★ 2^n−1 素数 ⇒ n 素数（经典定理实例）
   ========================================================= -/

/-- II3：2^3−1 = 7 素数（n=3 素数）。 -/
theorem ii3_prime3 : Nat.Prime (2 ^ 3 - 1) := by
  norm_num

/-- II3：2^5−1 = 31 素数（n=5 素数）。 -/
theorem ii3_prime5 : Nat.Prime (2 ^ 5 - 1) := by
  norm_num

/-- II3：2^7−1 = 127 素数（n=7 素数）。 -/
theorem ii3_prime7 : Nat.Prime (2 ^ 7 - 1) := by
  norm_num

/-- II3：2^4−1 = 15 合数（n=4 合数）。 -/
theorem ii3_comp4 : ¬ Nat.Prime (2 ^ 4 - 1) := by
  norm_num

/-- II3：2^6−1 = 63 合数（n=6 合数）。 -/
theorem ii3_comp6 : ¬ Nat.Prime (2 ^ 6 - 1) := by
  norm_num

/-- II3：2^8−1 = 255 合数（n=8 合数）。 -/
theorem ii3_comp8 : ¬ Nat.Prime (2 ^ 8 - 1) := by
  norm_num

/-- ★ II3 六实例联合（素数指数 {3,5,7} ↔ 合数指数 {4,6,8}——素数性 ↔ 指数素数性实例）。 -/
theorem ii3_union :
    Nat.Prime (2 ^ 3 - 1) ∧ Nat.Prime (2 ^ 5 - 1) ∧ Nat.Prime (2 ^ 7 - 1) ∧
    ¬ Nat.Prime (2 ^ 4 - 1) ∧ ¬ Nat.Prime (2 ^ 6 - 1) ∧ ¬ Nat.Prime (2 ^ 8 - 1) := by
  norm_num

/-! =========================================================
    §7 JJ ★ 窗口 2 家族段判据（一般定理）
   ========================================================= -/

/-- JJ ★ 一般恒等：a_j+w_j=b_j——家族段（Fermat 起边界）+宽度（Mersenne）=塔段（2 幂）。 -/
theorem jj_sum (j : ℕ) : (2 ^ (j + 1) + 1) + (2 ^ (j + 1) - 1) = 2 ^ (j + 2) := by
  have hge : 1 ≤ 2 ^ (j + 1) := by
    exact Nat.succ_le_of_lt (by positivity : 0 < 2 ^ (j + 1))
  have hpow : 2 ^ (j + 2) = 2 * 2 ^ (j + 1) := by
    calc
      2 ^ (j + 2) = 2 ^ ((j + 1) + 1) := rfl
      _ = 2 ^ (j + 1) * 2 := by rw [pow_succ]
      _ = 2 * 2 ^ (j + 1) := by rw [Nat.mul_comm]
  rw [hpow]
  omega

/-- JJ ★ 一般恒等：w_j = b_j−a_j = 2^{j+1}−1 = Mersenne_{j+1}（窗口宽度 = Mersenne 数）。 -/
theorem jj_width (j : ℕ) : 2 ^ (j + 2) - (2 ^ (j + 1) + 1) = 2 ^ (j + 1) - 1 := by
  have hge : 1 ≤ 2 ^ (j + 1) := by
    exact Nat.succ_le_of_lt (by positivity : 0 < 2 ^ (j + 1))
  have hpow : 2 ^ (j + 2) = 2 * 2 ^ (j + 1) := by
    calc
      2 ^ (j + 2) = 2 ^ ((j + 1) + 1) := rfl
      _ = 2 ^ (j + 1) * 2 := by rw [pow_succ]
      _ = 2 * 2 ^ (j + 1) := by rw [Nat.mul_comm]
  rw [hpow]
  omega

/-- ★★ JJ 判据一般形式：a_j+w_j=b_j 且 w_j=Mersenne_{j+1}（窗口 2 家族段三段统一，全 j 成立）。 -/
theorem jj_judgement (j : ℕ) :
    (2 ^ (j + 1) + 1) + (2 ^ (j + 1) - 1) = 2 ^ (j + 2) ∧
    2 ^ (j + 2) - (2 ^ (j + 1) + 1) = 2 ^ (j + 1) - 1 := by
  constructor
  · exact jj_sum j
  · exact jj_width j

/-- JJ 宽度实例（w_j = {7,15,31,63,127,255}，j=2..7）。 -/
theorem jj_width_instances :
    (2 ^ 4 - 9 = 7) ∧ (2 ^ 5 - 17 = 15) ∧ (2 ^ 6 - 33 = 31) ∧
    (2 ^ 7 - 65 = 63) ∧ (2 ^ 8 - 129 = 127) ∧ (2 ^ 9 - 257 = 255) := by
  norm_num

/-! =========================================================
    §8 JJ 静默段与根窗口对照
   ========================================================= -/

/-- JJ 静默段：c_j = 8·k_j+1（k_j=3·2^{j−2}）——{25,49,97,193,385,769}。 -/
theorem jj_silent_instances :
    (8 * 3 + 1 = 25) ∧ (8 * 6 + 1 = 49) ∧ (8 * 12 + 1 = 97) ∧
    (8 * 24 + 1 = 193) ∧ (8 * 48 + 1 = 385) ∧ (8 * 96 + 1 = 769) := by
  norm_num

/-- JJ 根窗口对照：c_1 = 8·1+1 = 9（窗口 1 位型例外——k_1=1 非 3·2^{j−2} 成员）。 -/
theorem jj_root_c1 : 8 * 1 + 1 = 9 := by
  norm_num

